# .env di PRODUZIONE per la ZimaBoard — copia in `.env` nella cartella del progetto e compila
# ogni riga. Il file resta sulla Zima e non va mai nel repository (.gitignore lo esclude).
# La procedura completa è in docs/deploy-zimaboard.md.

# ── Applicazione ────────────────────────────────────────────────────────────────
# Il nome pubblico dell'app, https, senza barra finale. DEVE coincidere con il public hostname
# del tunnel Cloudflare e con il redirect URI registrato su Google
# (https://turni.tuodominio.it/api/auth/google/callback).
APP_URL=https://turni.tuodominio.it

# Due chiavi DIVERSE, entrambe da `openssl rand -base64 32`.
# APP_ENCRYPTION_KEY cifra i refresh token Google: cambiarla dopo il primo accesso costringe tutti
# a rifare il login. SESSION_SECRET firma il cookie di sessione.
APP_ENCRYPTION_KEY=
SESSION_SECRET=

# ── Google (login e calendario) ─────────────────────────────────────────────────
# Lo stesso client OAuth usato in sviluppo: basta che abbia anche il redirect di produzione.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Lettura delle foto (Gemini) ─────────────────────────────────────────────────
GEMINI_API_KEY=
# Le altre variabili del provider hanno default sensati in docker-compose.yml
# (AI_PROVIDER=gemini, AI_STRATEGY=whole, GEMINI_MODEL=gemini-3.6-flash,
# GEMINI_MAX_OUTPUT_TOKENS=32768): non toccarle senza rimisurare, vedi CLAUDE.md.

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────────
# Solo il token (la stringa dopo `--token` nel comando che Cloudflare mostra), non il comando.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Privacy ─────────────────────────────────────────────────────────────────────
# Dopo quanti giorni le foto caricate vengono cancellate dal disco.
IMAGE_RETENTION_DAYS=90

# NON aggiungere DEV_LOGIN_EMAILS: in produzione è ignorata, ma la riga giusta nel file sbagliato
# è il primo passo di un ambiente configurato male.
