# Applicazione
APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=            # openssl rand -base64 32
SESSION_SECRET=                # openssl rand -base64 32
TZ=Europe/Rome

# Database
# Prisma risolve questo percorso relativamente a prisma/: il file reale è prisma/data/turni.db.
DATABASE_URL=file:./data/turni.db

# Provider AI (Fase 2)
AI_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Tunnel (deploy)
CLOUDFLARE_TUNNEL_TOKEN=

# Cartella delle foto caricate (nel container: /data/uploads)
UPLOAD_DIR=./data/uploads

# Privacy
IMAGE_RETENTION_DAYS=90
