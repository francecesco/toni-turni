# Applicazione
APP_URL=http://localhost:3000
# Per provare dal telefono: l'IP di rete del Mac (es. http://192.168.1.28:3001). Da qui
# vengono anche gli origin ammessi dal dev server (allowedDevOrigins); riavvia dopo il cambio.
APP_ENCRYPTION_KEY=            # openssl rand -base64 32
SESSION_SECRET=                # openssl rand -base64 32
TZ=Europe/Rome

# Database
# Prisma risolve questo percorso relativamente a prisma/: il file reale è prisma/data/turni.db.
DATABASE_URL=file:./data/turni.db

# Provider AI
AI_PROVIDER=gemini            # gemini | anthropic
AI_FALLBACK_PROVIDER=         # opzionale: provider di riserva
GEMINI_API_KEY=
# Il modello: l'elenco disponibile per una chiave si legge con
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
# Provato contro l'API il 2026-08-31: i modelli 2.5 rispondono 404 ("no longer
# available to new users") e i Pro rispondono 429 ("check your plan and billing
# details") perché hanno quota zero senza fatturazione attiva. I Flash rispondono.
# Con la fatturazione attiva vale la pena misurare un Pro: su una tabella corretta
# a penna è il candidato naturale. Il costo non è la variabile — una tabella al
# mese sono frazioni di centesimo in ogni caso.
GEMINI_MODEL=gemini-3.6-flash
# Tetto di token in uscita. Va largo: la tabella intera sono ~250 celle di JSON
# più i token di ragionamento, che contano nello stesso budget. Gemini fattura
# quelli usati e non quelli prenotati, quindi chiederne molti non costa nulla se
# non si usano — mentre un tetto stretto tronca la tabella a metà.
GEMINI_MAX_OUTPUT_TOKENS=32768
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Come si legge una tabella: `whole` (default) la manda intera in UNA chiamata;
# `bands` la taglia in mezzo mese per due colonne — più chiamate, ed è il percorso
# misurato al 99,8% per cella. La geometria del ritaglio non si configura affatto:
# la rileva il codice sulla foto.
AI_STRATEGY=whole
# Quanto può essere vecchio il battito di un estrazione prima di considerarla
# interrotta da un riavvio del processo (e quindi da riprendere).
EXTRACTION_STALE_MS=600000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Accesso di prova SENZA Google — SOLO SVILUPPO
# Lasciala spenta (commentata). Accendendola, chiunque raggiunga
# POST /api/auth/dev-login entra come una delle email elencate, senza password e
# senza Google: sono le sole identità raggiungibili, devono esistere già nel
# database e non ne viene creata nessuna.
# In produzione (NODE_ENV=production) è ignorata e la route risponde 404, quindi
# accenderla nel deploy non apre il bypass — ma non mettercela comunque: la riga
# giusta nel file sbagliato è il primo passo di un ambiente configurato male, e un
# domani che il container girasse fuori da NODE_ENV=production chiunque conosca
# l URL leggerebbe i turni di persone reali.
# Serve un utente già nel database. Finché il login Google non è configurato,
# creane uno a mano una volta sola:
#   npx tsx --env-file=.env -e "import {PrismaClient} from '@prisma/client'; const p = new PrismaClient(); \
#     p.user.create({ data: { email: 'anna@example.com', displayName: 'Anna', role: 'REFERENTE' } }) \
#     .then(() => console.log('creata')).finally(() => p.\$disconnect())"
# DEV_LOGIN_EMAILS=anna@example.com

# Cloudflare Tunnel (deploy)
CLOUDFLARE_TUNNEL_TOKEN=

# Cartella delle foto caricate (nel container: /data/uploads)
UPLOAD_DIR=./data/uploads

# Privacy
IMAGE_RETENTION_DAYS=90
