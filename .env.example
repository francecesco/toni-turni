# Applicazione
APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=            # openssl rand -base64 32
SESSION_SECRET=                # openssl rand -base64 32
TZ=Europe/Rome

# Database
# Prisma risolve questo percorso relativamente a prisma/: il file reale è prisma/data/turni.db.
DATABASE_URL=file:./data/turni.db

# Provider AI (Fase 2)
AI_PROVIDER=groq              # groq | anthropic
AI_FALLBACK_PROVIDER=         # opzionale: provider di riserva
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Estrazione a bande (Fase 2A-bis)
# Tetto di token in uscita prenotati a ogni chiamata. Groq conta i prenotati, non
# gli usati: alzarlo fa rifiutare la richiesta, abbassarlo rischia il troncamento
# (una banda troncata è una banda persa). Vedi providers/groq.ts.
GROQ_MAX_OUTPUT_TOKENS=4000
# La pausa fra una banda e l altra NON si configura: la calcola `createTokenPacer`
# sul peso misurato di una banda (6700 token) e sul tetto al minuto del piano
# gratuito (8000), cioè ~50 s. La geometria dei ritagli non si configura affatto:
# la rileva `cropRosterBands` sulla foto.
# Quanto può essere vecchio il battito di un estrazione prima di considerarla
# interrotta da un riavvio del processo (e quindi da riprendere).
EXTRACTION_STALE_MS=600000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Accesso di prova SENZA Google — SOLO SVILUPPO
# Lasciala spenta (commentata). Accendendola, chiunque raggiunga
# POST /api/auth/dev-login entra come una delle email elencate, senza password e
# senza Google: sono le sole identità raggiungibili, devono esistere già nel
# database e non ne viene creata nessuna.
# In produzione (NODE_ENV=production) è ignorata e la route risponde 404, quindi
# accenderla nel deploy non apre il bypass — ma non mettercela comunque: la riga
# giusta nel file sbagliato è il primo passo di un ambiente configurato male, e un
# domani che il container girasse fuori da NODE_ENV=production chiunque conosca
# l URL leggerebbe i turni di persone reali.
# Serve un utente già nel database. Finché il login Google non è configurato,
# creane uno a mano una volta sola:
#   npx tsx --env-file=.env -e "import {PrismaClient} from '@prisma/client'; const p = new PrismaClient(); \
#     p.user.create({ data: { email: 'anna@example.com', displayName: 'Anna', role: 'REFERENTE' } }) \
#     .then(() => console.log('creata')).finally(() => p.\$disconnect())"
# DEV_LOGIN_EMAILS=anna@example.com

# Cloudflare Tunnel (deploy)
CLOUDFLARE_TUNNEL_TOKEN=

# Cartella delle foto caricate (nel container: /data/uploads)
UPLOAD_DIR=./data/uploads

# Privacy
IMAGE_RETENTION_DAYS=90
