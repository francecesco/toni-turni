# Applicazione
APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=            # openssl rand -base64 32
SESSION_SECRET=                # openssl rand -base64 32
TZ=Europe/Rome

# Database
# Prisma risolve questo percorso relativamente a prisma/: il file reale è prisma/data/turni.db.
DATABASE_URL=file:./data/turni.db

# Provider AI (Fase 2)
AI_PROVIDER=groq              # groq | anthropic
AI_FALLBACK_PROVIDER=         # opzionale: provider di riserva
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Estrazione a bande (Fase 2A-bis)
# Pausa fra una banda e l altra: il piano gratuito di Groq ha un tetto di token al
# minuto, e una tabella sono 10-14 letture. Con 50s l estrazione dura 10-20 minuti.
AI_BAND_PAUSE_MS=50000
# Quota di colonna aggiunta ai lati di ogni ritaglio, perché una colonna tagliata a
# metà da un taglio imperfetto resti intera nella banda vicina.
BAND_OVERLAP_FRACTION=0.35
# Quanto può essere vecchio il battito di un estrazione prima di considerarla
# interrotta da un riavvio del processo (e quindi da riprendere).
EXTRACTION_STALE_MS=600000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Tunnel (deploy)
CLOUDFLARE_TUNNEL_TOKEN=

# Cartella delle foto caricate (nel container: /data/uploads)
UPLOAD_DIR=./data/uploads

# Privacy
IMAGE_RETENTION_DAYS=90
